# ---- Required ----
TELEGRAM_BOT_TOKEN=8613881387:AAG-TYFEYdCyXO7zzxTLO7V87d7VEXVnA6s
# Your chat ID, your friend's, or a group ID (comma separated)
TELEGRAM_CHAT_ID=-5218940772

# ---- Strongly recommended ----
# Free "Demo" key from https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# Where alert memory is saved. On Railway attach a Volume at /data
DATA_DIR=/data

# ---- Schedule ----
SCAN_CRON=0 8 * * *
TIMEZONE=Africa/Lagos
RUN_ON_START=true

# ---- Timing window (days before the unlock) ----
WINDOW_DAYS=30
MIN_DAYS_AHEAD=3

# ---- Edge filters ----
MIN_UNLOCK_PCT=2
MIN_UNLOCK_USD=1000000
MAX_MCAP_USD=5000000000
MIN_FUTURES_VOLUME_USD=2000000
REQUIRE_PERP=true
MIN_SCORE=55
EXCHANGES=binance,bybit

# ---- Result tracking ----
TRACK_RESULTS=true
RESULT_DAYS_AFTER_UNLOCK=7

# ---- Misc ----
SEND_STARTUP_MESSAGE=true
SEND_DAILY_SUMMARY=false
MAX_ALERTS_PER_SCAN=10
FETCH_CONCURRENCY=4
